{
  "buildCommand": "npm --prefix website ci && npm --prefix website run build",
  "outputDirectory": "website/dist",
  "installCommand": "npm ci && npm --prefix server ci",
  "functions": {
    "server/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server/index.js" }
  ]
}
