{
  "name": "comfyclips",
  "version": "1.3.0",
  "description": "Interactive CLI to download video or audio from social media platforms (YouTube, TikTok, Instagram, Reddit, Pinterest, Vimeo, Dailymotion, Rumble, LinkedIn, Snapchat, Facebook, X/Twitter) via yt-dlp.",
  "type": "module",
  "bin": {
    "comfyclips": "./src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/**/*.test.js"
  },
  "keywords": [
    "cli",
    "video-downloader",
    "yt-dlp",
    "youtube",
    "tiktok",
    "reddit",
    "pinterest",
    "vimeo",
    "instagram",
    "twitter",
    "facebook",
    "dailymotion",
    "rumble",
    "linkedin",
    "snapchat"
  ],
  "author": "Hamza Imran",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.0",
    "adm-zip": "^0.6.0",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "ffmpeg-static": "^5.3.0",
    "figlet": "^1.11.4",
    "inquirer": "^14.1.0",
    "ora": "^8.1.0",
    "yt-dlp-wrap-plus": "^2.5.0"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
